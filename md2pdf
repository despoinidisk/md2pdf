def set_direction(diagram: str, direction: str) -> str:
    """Force a supported diagram's layout direction."""
    diagram = FLOWCHART_HEADER.sub(
        lambda match: f"{match.group(1)}{match.group(2)} {direction}",
        diagram,
        count=1,
    )
    diagram = FLOWCHART_DIRECTION.sub(
        lambda match: f"{match.group(1)}direction {direction}",
        diagram,
    )

    def inject(match: re.Match[str]) -> str:
        if re.search(r"^[ \t]*direction\b", diagram, re.MULTILINE):
            return match.group(0)
        return f"{match.group(0)}\ndirection {direction}"

    return DIRECTIONAL_DIAGRAM.sub(inject, diagram, count=1)


def apply_direction(diagram: str, direction: str) -> str:
    """Leave TB alone; rewrite the source for LR."""
    return diagram if direction == "TB" else set_direction(diagram, direction)


def run_mmdc(
    mmdc: str,
    source: Path,
    destination: Path,
    number: int,
    scale: int | None = None,
) -> None:
    """Render one diagram file with mermaid-cli."""
    command = [mmdc, "-i", str(source), "-o", str(destination), "-b", "transparent"]
    if scale is not None:
        command.extend(["-s", str(scale)])
    command.append("-q")

    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode != 0 or not destination.exists():
        detail = result.stderr.strip() or result.stdout.strip() or "unknown error"
        raise RuntimeError(
            f"could not render Mermaid diagram {number} as "
            f"{destination.suffix.lstrip('.')}: {detail}"
        )


def render_mermaid(
    markdown_text: str,
    work_dir: Path,
    need_svg: bool = False,
    direction: str = "TB",
    square_layout: bool = False,
) -> tuple[str, dict[str, RenderedDiagram]]:
    """Render Mermaid fences to PNG (and optionally SVG), replacing them with tokens."""
    blocks = list(MERMAID_FENCE.finditer(markdown_text))
    if not blocks:
        return markdown_text, {}

    mmdc = shutil.which("mmdc")
    if mmdc is None:
        raise RuntimeError(
            "Mermaid diagrams found, but 'mmdc' (mermaid-cli) is not installed. "
            "Install it with: npm install -g @mermaid-js/mermaid-cli"
        )

    diagrams: dict[str, RenderedDiagram] = {}
    parts: list[str] = []
    end = 0

    for index, block in enumerate(blocks):
        original = block.group("diagram")
        if square_layout:
            candidates = [
                ("tb", set_direction(original, "TB")),
                ("lr", set_direction(original, "LR")),
            ]
        else:
            candidates = [("main", apply_direction(original, direction))]

        best: tuple[float, Path, Path] | None = None
        for label, text in candidates:
            source = work_dir / f"diagram-{index}-{label}.mmd"
            png = work_dir / f"diagram-{index}-{label}.png"
            source.write_text(text, encoding="utf-8")
            run_mmdc(mmdc, source, png, index + 1, scale=2)
            with Image.open(png) as image:
                width, height = image.size
            score = abs(math.log(width / height))
            if best is None or score < best[0]:
                best = (score, source, png)

        assert best is not None
        source, png = best[1], best[2]
        svg = work_dir / f"diagram-{index}-svg.svg" if need_svg else None
        if svg is not None:
            run_mmdc(mmdc, source, svg, index + 1)

        token = f"MD2PDFMERMAID{index}TOKEN"
        parts.append(markdown_text[end:block.start()])
        parts.append(f"\n\n{token}\n\n")
        diagrams[token] = RenderedDiagram(png=png, svg=svg)
        end = block.end()

    parts.append(markdown_text[end:])
    return "".join(parts), diagrams


def square_png(path: Path, destination: Path) -> Path:
    """Pad a PNG to a transparent square canvas without distorting it."""
    with Image.open(path) as image:
        width, height = image.size
        side = max(width, height)
        canvas = Image.new("RGBA", (side, side), (0, 0, 0, 0))
        canvas.paste(
            image.convert("RGBA"),
            ((side - width) // 2, (side - height) // 2),
        )
        canvas.save(destination)
    return destination


def square_svg(path: Path, destination: Path) -> Path:
    """Expand an SVG viewBox to a square canvas without distorting it."""
    content = path.read_text(encoding="utf-8")
    tag_match = re.search(r"<svg\b[^>]*>", content)
    if tag_match is None:
        return path

    tag = tag_match.group(0)
    viewbox_match = re.search(r'viewBox="([^"]+)"', tag)
    if viewbox_match is None:
        return path

    values = re.split(r"[\s,]+", viewbox_match.group(1).strip())
    if len(values) != 4:
        return path
    x, y, width, height = (float(value) for value in values)
    side = max(width, height)
    new_viewbox = (
        f"{x + (width - side) / 2:g} {y + (height - side) / 2:g} "
        f"{side:g} {side:g}"
    )

    new_tag = tag.replace(
        f'viewBox="{viewbox_match.group(1)}"',
        f'viewBox="{new_viewbox}"',
    )
    new_tag = re.sub(r"max-width:\s*[\d.]+px", f"max-width: {side:g}px", new_tag)
    new_tag = re.sub(r'\bwidth="[\d.]+"', f'width="{side:g}"', new_tag)
    new_tag = re.sub(r'\bheight="[\d.]+"', f'height="{side:g}"', new_tag)

    destination.write_text(
        content[:tag_match.start()] + new_tag + content[tag_match.end():],
        encoding="utf-8",
    )
    return destination


def make_square(diagram: RenderedDiagram, work_dir: Path, index: int) -> RenderedDiagram:
    """Pad a rendered diagram's PNG (and SVG, if present) to square canvases."""
    png = square_png(diagram.png, work_dir / f"diagram-{index}-square.png")
    svg = None
    if diagram.svg is not None:
        svg = square_svg(diagram.svg, work_dir / f"diagram-{index}-square.svg")
    return RenderedDiagram(png=png, svg=svg)


def markdown_to_html(
    markdown_text: str, diagrams: dict[str, RenderedDiagram]
) -> str:
    """Convert Markdown to an HTML fragment and insert rendered diagrams."""
    html_body = markdown.markdown(
        markdown_text,
        extensions=["tables", "fenced_code", "sane_lists"],
    )
    for token, diagram in diagrams.items():
        figure = (
            '<figure class="mermaid">'
            f'<img src="{escape(diagram.png.as_uri(), quote=True)}" alt="Mermaid diagram">'
            "</figure>"
        )
        html_body = html_body.replace(f"<p>{token}</p>", figure).replace(token, figure)
    return html_body


def export_diagrams(
    diagrams: dict[str, RenderedDiagram], output_path: Path
) -> Path | None:
    """Copy rendered PNG and SVG files into <pdf-stem>-diagrams/ beside the PDF."""
    if not diagrams:
        return None

    directory = output_path.parent / f"{output_path.stem}-diagrams"
    directory.mkdir(parents=True, exist_ok=True)
    for index, diagram in enumerate(diagrams.values(), start=1):
        shutil.copy2(diagram.png, directory / f"diagram-{index}.png")
        if diagram.svg is not None:
            shutil.copy2(diagram.svg, directory / f"diagram-{index}.svg")
    return directory


def build_html(html_body: str, title: str) -> str:
    return f"""<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>{escape(title)}</title>
    <style>{CSS}</style>
</head>
<body>
{html_body}
</body>
</html>
"""


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Convert a Markdown file to PDF (Mermaid diagrams supported)."
    )
    parser.add_argument("input", type=Path, help="Markdown file to convert")
    parser.add_argument(
        "-o", "--output",
        type=Path,
        help="PDF path (default: input path with a .pdf extension)",
    )
    parser.add_argument(
        "--export-diagrams",
        action="store_true",
        help="also save diagrams to <pdf-name>-diagrams/ beside the PDF",
    )
    layout = parser.add_mutually_exclusive_group()
    layout.add_argument(
        "--diagram-direction",
        choices=["TB", "LR"],
        default="TB",
        help="flowchart layout (LR makes tall diagrams shorter and wider)",
    )
    layout.add_argument(
        "--square-layout",
        action="store_true",
        help="try TB and LR layouts and use the one closest to square",
    )
    parser.add_argument(
        "--pad-square",
        action="store_true",
        help="cosmetic: pad diagrams to a square transparent canvas",
    )
    args = parser.parse_args(argv)

    input_path = args.input
    if not input_path.is_file():
        parser.error(f"input file not found: {input_path}")

    output_path = args.output or input_path.with_suffix(".pdf")
    if output_path.resolve() == input_path.resolve():
        parser.error("output path must differ from input path")
    output_path.parent.mkdir(parents=True, exist_ok=True)

    try:
        markdown_text = input_path.read_text(encoding="utf-8")
        with tempfile.TemporaryDirectory(prefix="md2pdf-") as temp_dir:
            prepared_markdown, diagrams = render_mermaid(
                markdown_text,
                Path(temp_dir),
                need_svg=args.export_diagrams,
                direction=args.diagram_direction,
                square_layout=args.square_layout,
            )
            if args.pad_square:
                diagrams = {
                    token: make_square(diagram, Path(temp_dir), index)
                    for index, (token, diagram) in enumerate(diagrams.items())
                }
            html_body = markdown_to_html(prepared_markdown, diagrams)
            html_document = build_html(html_body, input_path.stem)
            HTML(
                string=html_document,
                base_url=str(input_path.absolute().parent),
            ).write_pdf(str(output_path))
            diagram_dir = (
                export_diagrams(diagrams, output_path) if args.export_diagrams else None
            )
    except Exception as exc:
        print(f"md2pdf: error: {exc}", file=sys.stderr)
        return 1

    print(f"PDF written to {output_path}")
    if diagram_dir is not None:
        print(f"Diagrams written to {diagram_dir}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
