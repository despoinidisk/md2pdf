#!/usr/bin/env python3
"""Convert a Markdown file to PDF, rendering Mermaid diagrams when present."""

from __future__ import annotations

import argparse
import re
import shutil
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from html import escape
from pathlib import Path

import markdown
from weasyprint import HTML

FLOWCHART_HEADER = re.compile(
    r"^([ \t]*)(graph|flowchart)(?:[ \t]+(?:TD|TB|BT|RL))?[ \t]*$",
    re.MULTILINE,
)
FLOWCHART_DIRECTION = re.compile(
    r"^([ \t]*)direction[ \t]+(?:TD|TB|BT|RL)\b", re.MULTILINE
)

MERMAID_FENCE = re.compile(
    r"^(?P<fence>`{3,}|~{3,})[ \t]*mermaid[^\n]*\n"
    r"(?P<diagram>.*?)"
    r"^(?P=fence)[ \t]*$",
    re.MULTILINE | re.DOTALL,
)

@dataclass(frozen=True)
class RenderedDiagram:
    png: Path
    svg: Path | None = None


CSS = """
@page {
    size: A4;
    margin: 2.5cm;
    @bottom-center {
        content: counter(page);
        font-size: 9pt;
        color: #888;
    }
}
body {
    font-family: 'Liberation Sans', 'Arial', 'Helvetica', sans-serif;
    font-size: 11pt;
    line-height: 1.6;
    color: #333;
}
h1, h2 {
    color: #111;
    border-bottom: 1px solid #ddd;
    padding-bottom: 0.3em;
}
h3, h4, h5, h6 { color: #222; }
a { color: #0645ad; }
code {
    background: #f4f4f4;
    padding: 2px 4px;
    font-family: 'SFMono-Regular', Consolas, monospace;
    font-size: 0.9em;
}
pre {
    background: #f4f4f4;
    padding: 1em;
    border-radius: 5px;
    white-space: pre-wrap;
    page-break-inside: avoid;
}
