#!/usr/bin/env python3
"""Convert a Markdown file to PDF, rendering Mermaid diagrams when present."""

from __future__ import annotations

import argparse
import math
import re
import shutil
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from html import escape
from pathlib import Path

import markdown
from PIL import Image
from weasyprint import HTML

FLOWCHART_HEADER = re.compile(
    r"^([ \t]*)(graph|flowchart)(?:[ \t]+(?:TD|TB|BT|LR|RL))?[ \t]*$",
    re.MULTILINE,
)
FLOWCHART_DIRECTION = re.compile(
    r"^([ \t]*)direction[ \t]+(?:TD|TB|BT|LR|RL)\b", re.MULTILINE
)
DIRECTIONAL_DIAGRAM = re.compile(
    r"^(stateDiagram(?:-v2)?|classDiagram|erDiagram)[ \t]*$", re.MULTILINE
)

MERMAID_FENCE = re.compile(
    r"^(?P<fence>`{3,}|~{3,})[ \t]*mermaid[^\n]*\n"
    r"(?P<diagram>.*?)"
    r"^(?P=fence)[ \t]*$",
    re.MULTILINE | re.DOTALL,
)

@dataclass(frozen=True)
class RenderedDiagram:
    png: Path
    svg: Path | None = None


